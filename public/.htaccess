# ---------------------------------------------------------------------------
# SazehShop — تنظیمات آپاچی برای پوشه public (DocumentRoot دامنه)
# همه درخواست‌ها به index.php هدایت می‌شوند (URL های تمیز).
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # اگر سایت در زیرپوشه نصب شده است، مسیر پایه را اینجا تنظیم کنید:
    # RewriteBase /shop/public/

    # فایل‌ها و پوشه‌های واقعی دست‌نخورده می‌مانند
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # بقیه درخواست‌ها → front controller
    RewriteRule ^ index.php [L]
</IfModule>

# --- هدرهای امنیتی ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # اگر سایت روی HTTPS است این خط را فعال کنید
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- صفحه خطای سفارشی (در صورت نبود mod_rewrite) ---
ErrorDocument 404 /index.php

# --- کش فایل‌های استاتیک ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# --- فشرده‌سازی ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- سرویس‌ورکر باید همیشه تازه باشد ---
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</Files>
<Files "manifest.webmanifest">
    <IfModule mod_headers.c>
        Header set Content-Type "application/manifest+json"
    </IfModule>
</Files>

# --- جلوگیری از اجرای PHP در پوشه آپلودها ---
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php\d|phar)$ - [F,L]
</IfModule>

# --- عدم دسترسی به فایل‌های مخفی ---
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
